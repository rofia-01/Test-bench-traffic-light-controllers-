timescale 1ns / 1ps

module traffic_controller_tb;

    // Inputs
    reg clk;
    reg reset;

    // Outputs
    wire north_red;
    wire north_yellow;
    wire north_green;

    wire east_red;
    wire east_yellow;
    wire east_green;

    // Instantiate DUT
    traffic_controller uut (
        .clk(clk),
        .reset(reset),

        .north_red(north_red),
        .north_yellow(north_yellow),
        .north_green(north_green),

        .east_red(east_red),
        .east_yellow(east_yellow),
        .east_green(east_green)
    );

    // Clock generation
    // 10 ns period = 100 MHz
    always #5 clk = ~clk;

    // Test sequence
    initial begin

        // Initialize
        clk   = 0;
        reset = 1;

        // Apply reset
        #20;
        reset = 0;

        // Run simulation
        #5000;

        // Finish
        $finish;
    end

    // Monitor signals
    initial begin
        $monitor(
            "Time=%0t | NS: R=%b Y=%b G=%b | EW: R=%b Y=%b G=%b",
            $time,
            north_red,
            north_yellow,
            north_green,
            east_red,
            east_yellow,
            east_green
        );
    end

endmodule
